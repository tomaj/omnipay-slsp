{
    "name": "tomaj/omnipay-slsp",
    "description": "SporoPay (Slovenská sporiteľňa) gateway for the Omnipay payment processing library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "slsp",
        "sporitelna",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "sporopay",
        "slovakia"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "homepage": "https://tomaj.github.io/omnipay-slsp/",
    "support": {
        "issues": "https://github.com/tomaj/omnipay-slsp/issues",
        "source": "https://github.com/tomaj/omnipay-slsp",
        "docs": "https://tomaj.github.io/omnipay-slsp/",
        "security": "https://github.com/tomaj/omnipay-slsp/security/policy"
    },
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "omnipay/common": "^3.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.35",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.8"
    },
    "suggest": {
        "php-http/guzzle7-adapter": "An HTTP client for Omnipay (omnipay/common needs a PSR-18/HTTPlug client implementation)"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Omnipay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@rector",
            "@test"
        ],
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover build/logs/clover.xml --coverage-html build/coverage"
        ],
        "cs-fix": "php-cs-fixer fix",
        "infection": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ],
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": [
            "@putenv XDEBUG_MODE=off",
            "phpunit --no-coverage"
        ],
        "rector": "rector --dry-run",
        "rector-fix": "rector",
        "test": "@phpunit"
    },
    "scripts-descriptions": {
        "check": "Run code style, PHPStan, Rector and the tests",
        "coverage": "Run the tests with a Clover and HTML coverage report in build/ (needs Xdebug or PCOV)",
        "cs-fix": "Fix the code style",
        "infection": "Run mutation testing with Infection (needs Xdebug or PCOV)",
        "phpcs": "Check the code style (PER-CS)",
        "phpstan": "Run PHPStan (level max)",
        "phpunit": "Run the tests without coverage",
        "rector": "Show the changes Rector would make",
        "rector-fix": "Apply the Rector changes",
        "test": "Run the tests"
    }
}
