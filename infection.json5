{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "build/infection.log",
        "html": "build/infection.html",
        "summary": "build/infection-summary.log",
        "json": "build/infection.json"
    },
    "mutators": {
        "@default": true,
        // a 16-byte key becomes K1 K2 K1 (24 bytes); OpenSSL uses only the first 24 bytes of a longer key,
        // so appending 9 bytes or the whole key again signs the same for 16- and 24-byte secrets
        "IncrementInteger": {
            "ignore": [
                "Omnipay\\SporoPay\\Sign\\Des3Sign::sign"
            ]
        },
        "UnwrapSubstr": {
            "ignore": [
                "Omnipay\\SporoPay\\Sign\\Des3Sign::sign"
            ]
        }
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    "phpUnit": {
        "configDir": "."
    },
    // the examples run in separate processes and only exercise code the unit tests already cover
    "testFrameworkOptions": "--exclude-group=examples"
}
